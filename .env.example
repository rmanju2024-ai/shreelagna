NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Auth → URL configuration: add the live site callback, e.g.
# https://shreelagna.vercel.app/auth/callback
# http://localhost:3000/auth/callback
# Never expose the service role to the browser
SMS_OTP_REQUIRED=false
NOTIFY_CHANNEL=arattai
# Arattai Business API (preferred). Apply at Arattai Business / Zoho API console.
ARATTAI_ACCESS_TOKEN=
ARATTAI_PHONE_NUMBER_ID=
ARATTAI_API_BASE=https://arattai.zoho.in/arattai/v1
ARATTAI_ACCOUNTS_BASE=https://accounts.zoho.in
ARATTAI_AUTH_SCHEME=Zoho-oauthtoken
ARATTAI_CLIENT_ID=
ARATTAI_CLIENT_SECRET=
ARATTAI_REFRESH_TOKEN=
ARATTAI_SEND_URL=
ARATTAI_OTP_TEMPLATE=
ARATTAI_INTEREST_TEMPLATE=
ARATTAI_ACCEPTED_TEMPLATE=
ARATTAI_PLAN_TEMPLATE=
ARATTAI_LANGUAGE=en
# WhatsApp Cloud API — kept unused unless NOTIFY_CHANNEL=whatsapp.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v25.0
WHATSAPP_OTP_TEMPLATE=shreelagna_otp
WHATSAPP_OTP_LANGUAGE=en_US
WHATSAPP_OTP_COPY_CODE=true
WHATSAPP_INTEREST_TEMPLATE=shreelagna_interest
WHATSAPP_ACCEPTED_TEMPLATE=shreelagna_interest_accepted
WHATSAPP_PLAN_TEMPLATE=shreelagna_plan
# Test alerts with Meta hello_world until utility templates are approved.
WHATSAPP_ALERT_TEMPLATE=hello_world
WHATSAPP_OTP_REQUIRED=false
