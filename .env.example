NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Auth → URL configuration: add the live site callback, e.g.
# https://shreelagna.vercel.app/auth/callback
# http://localhost:3000/auth/callback
# Never expose the service role to the browser
SMS_OTP_REQUIRED=false
# Arattai Business Platform — OTP + transactional house alerts. WhatsApp is unused.
# Console: https://business.arattai.in  Signup: https://business.arattai.in/signup
# Accounts / OAuth: https://accounts.arattai.in  Developer: https://accounts.arattai.in/developerconsole
ARATTAI_CLIENT_ID=
ARATTAI_CLIENT_SECRET=
ARATTAI_REFRESH_TOKEN=
ARATTAI_COMPANY_ID=
ARATTAI_BUSINESS_NUMBER_ID=
ARATTAI_OTP_TEMPLATE_ID=
ARATTAI_ALERT_TEMPLATE_ID=
ARATTAI_TEMPLATE_LANGUAGE=en
ARATTAI_OAUTH_SCOPE=ArattaiBusiness.messages.CREATE,ArattaiBusiness.authentications.CREATE
ARATTAI_ACCOUNTS_URL=https://accounts.arattai.in
ARATTAI_API_BASE=https://business.arattai.in/api/v1
ARATTAI_AUTH_SCHEME=Zoho-oauthtoken
# Web Push (VAPID). Generate: npx web-push generate-vapid-keys
# Production needs HTTPS. iOS Safari only after Add to Home Screen (16.4+).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:house@shreelagna.com
# Legacy WhatsApp Cloud env — kept unused; live OTP/alerts go through Arattai.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v25.0
WHATSAPP_OTP_TEMPLATE=shreelagna_otp
WHATSAPP_OTP_LANGUAGE=en_US
WHATSAPP_OTP_COPY_CODE=true
WHATSAPP_INTEREST_TEMPLATE=shreelagna_interest
WHATSAPP_ACCEPTED_TEMPLATE=shreelagna_interest_accepted
WHATSAPP_PLAN_TEMPLATE=shreelagna_plan
WHATSAPP_ALERT_TEMPLATE=hello_world
WHATSAPP_OTP_REQUIRED=false
